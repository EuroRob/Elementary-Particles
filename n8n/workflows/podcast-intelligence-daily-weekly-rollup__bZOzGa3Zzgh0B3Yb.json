      "id": "fe8a521b-af06-4575-9d7e-59550ae3b38a",
      "name": "Format Message",
      "parameters": {
        "jsCode": "const b = $input.first().json;\nconst date = b.date || new Date().toDateString();\nconst count = b.episode_count || 0;\nconst eps = (b.episodes || []).map(e => '• ' + e.title + ' (' + e.podcast + ')').join('\\n');\nconst overview = b.briefing || 'No briefing available';\nconst text = '🎤 Morning Briefing — ' + date + '\\n\\n' + overview + '\\n\\n📻 Episodes featured (' + count + '):\\n' + eps;\nconst matrixPayload = JSON.stringify({ msgtype: 'm.text', body: text });\nreturn [{ json: { text, txn_id: Date.now().toString(), matrixPayload } }];"
      },
      "position": [
        680,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "format-weekly-001",
      "name": "Format Weekly Message",
      "parameters": {
        "jsCode": "const b = $input.first().json;\nconst week = b.week_label || 'this week';\nconst count = b.episode_count || 0;\nconst podcastCount = b.podcast_count || 0;\nconst shows = (b.podcasts || []).map(p => '\\u2022 ' + p.podcast + ' (' + p.episode_count + ' episodes)').join('\\n');\nconst overview = b.briefing || 'No weekly briefing available';\nconst text = '\\ud83c\\udf99\\ufe0f Weekly Podcast Rollup \\u2014 ' + week + '\\n\\n' + overview + '\\n\\n\\ud83d\\udcca ' + count + ' episodes across ' + podcastCount + ' shows:\\n' + shows;\nconst matrixPayload = JSON.stringify({ msgtype: 'm.text', body: text });\nreturn [{ json: { text, txn_id: 'weekly-' + Date.now(), matrixPayload } }];\n"
      },
      "position": [
        1120,
        420
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
