        "specifyBody": "json",
        "url": "=http://10.0.30.45:8448/_matrix/client/v3/rooms/!EXAMPLEROOMID0000:home.example.org/send/m.room.message/{{ $json.txn_id }}"
      },
      "position": [
        1300,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "d6e340f0-76ed-482b-a8d0-dd57a913a865",
      "name": "Split VMs",
      "parameters": {
        "jsCode": "const vms = $input.first().json.data || [];\nreturn vms.map(vm => ({ json: vm }));"
      },
      "position": [
