    {
      "id": "travelcheck1",
      "name": "Travel Question?",
      "parameters": {
        "jsCode": "// Cheap pre-filter: only travel-ish messages go to travel-api (/assistant/ask),\n// everything else keeps the old direct-Ollama path and speed. travel-api itself\n// answers {handled:false} for anything that isn't really about travel.\nconst b = $input.item.json.body || {};\nconst text = (b.text || '').toLowerCase();\nconst re = /\\b(trip|trips|travel|travell?ing|vacation|holiday|journey|itinerar|flight|fly|flying|plane|airport|train|trains|rail|station|platform|departure|depart|arriv|delay|ferry|bus|hotel|hostel|stay|staying|check.?in|check.?out|booking|book|pack|packing|hike|hikes|hiking|trail|walk|weather|rain|snow|forecast|adventurelog|reise|reisen|urlaub|ferien|flug|flughafen|zug|züge|bahn|bahnhof|gleis|abfahrt|ankunft|verspätung|fähre|unterkunft|übernacht|wander|wanderung|wanderweg|wetter|regen|schnee|packliste)/i;\nreturn { json: { ...$input.item.json, isTravel: !!b.speaker && !!b.text && re.test(text) } };"
      },
      "position": [
        220,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    }
