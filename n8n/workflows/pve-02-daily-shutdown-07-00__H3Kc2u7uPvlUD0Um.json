      "parameters": {
        "jsCode": "const vms = $('pve-02 VM list').all().map(i => i.json);\nconst res = $input.all();\nconst results = vms.map((v, i) => {\n  const j = res[i]?.json || {};\n  return { vmid: v.vmid, name: v.name, status: j.data?.status ?? null,\n           error: j.error ? String(j.error.message || j.error).slice(0, 160) : null };\n});\nconst fmt = r => `${r.name}(${r.vmid}): ${r.status || 'ERR ' + r.error}`;\n\nconst up = results.some(r => r.status);\nreturn [{ json: { up, running: results.filter(r => r.status === 'running').map(fmt), results } }];"
