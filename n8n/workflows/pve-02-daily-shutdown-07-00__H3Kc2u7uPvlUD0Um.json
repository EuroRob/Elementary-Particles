        "jsCode": "const j = $input.first().json;\nconst up = !!j.data?.status;\nconst txn_id = 'pve-02-shutdown-hostup-' + Date.now();\nconst body = '\\u26a0\\ufe0f pve-02 daily shutdown: all VMs stopped cleanly and host shutdown was sent, '\n  + 'but pve-02 still answers 150s later. Check pve-02 (10.10.0.12) manually.';\nreturn [{ json: { up, txn_id, matrixPayload: { msgtype: 'm.text', body } } }];"
