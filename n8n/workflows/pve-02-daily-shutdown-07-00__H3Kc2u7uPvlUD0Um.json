      "id": "pve-02-shutdown-13",
      "name": "All stopped?",
      "parameters": {
        "jsCode": "const vms = $('Re-list VMs').all().map(i => i.json);\nconst res = $input.all();\nconst results = vms.map((v, i) => {\n  const j = res[i]?.json || {};\n  return { vmid: v.vmid, name: v.name, status: j.data?.status ?? null,\n           error: j.error ? String(j.error.message || j.error).slice(0, 160) : null };\n});\nconst fmt = r => `${r.name}(${r.vmid}): ${r.status || 'ERR ' + r.error}`;\n\nconst attempt = $('Re-list VMs').first().json.attempt;\nconst notStopped = results.filter(r => r.status !== 'stopped');\nreturn [{ json: { allStopped: notStopped.length === 0, attempt, retry: notStopped.length > 0 && attempt < 3,\n                  notStopped: notStopped.map(fmt), results } }];"
      },
      "position": [
        2200,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
