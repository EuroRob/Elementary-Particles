    {
      "id": "format-daily-summary-for-matrix-001",
      "name": "Format Daily Summary for Matrix",
      "parameters": {
        "jsCode": "const items = $input.all();\nconst periodType = (items[0] && items[0].json.period_type) || 'daily';\nconst isWeekly = periodType === 'weekly';\nconst dateLabel = $now.toFormat('yyyy-MM-dd');\nconst header = (isWeekly ? '\\ud83d\\udcd6 Weekly' : '\\ud83d\\udcd6 Daily') + ' News Summary \\u2014 ' + dateLabel;\nconst sections = items.map(i => {\n  const j = i.json;\n  return '**' + j.category + '** (' + j.article_count + ' articles)\\n' + j.summary;\n}).join('\\n\\n');\nconst text = header + '\\n\\n' + sections + '\\n\\n_' + items.length + ' categories \\u2014 posted by news-bot_';\nconst txn_id = periodType + '-summary-' + Date.now();\nreturn [{ json: { txn_id, matrixPayload: { msgtype: 'm.text', body: text } } }];\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        1160,
        560
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "format-weekly-summary-for-matrix-001",
      "name": "Format Weekly Summary for Matrix",
      "parameters": {
        "jsCode": "const items = $input.all();\nconst periodType = (items[0] && items[0].json.period_type) || 'daily';\nconst isWeekly = periodType === 'weekly';\nconst dateLabel = $now.toFormat('yyyy-MM-dd');\nconst header = (isWeekly ? '\\ud83d\\udcd6 Weekly' : '\\ud83d\\udcd6 Daily') + ' News Summary \\u2014 ' + dateLabel;\nconst sections = items.map(i => {\n  const j = i.json;\n  return '**' + j.category + '** (' + j.article_count + ' articles)\\n' + j.summary;\n}).join('\\n\\n');\nconst text = header + '\\n\\n' + sections + '\\n\\n_' + items.length + ' categories \\u2014 posted by news-bot_';\nconst txn_id = periodType + '-summary-' + Date.now();\nreturn [{ json: { txn_id, matrixPayload: { msgtype: 'm.text', body: text } } }];\n",
        "mode": "runOnceForAllItems"
      },
