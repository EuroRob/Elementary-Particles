    {
      "id": "3",
      "name": "Group Short-Term By Category",
      "parameters": {
        "jsCode": "\nconst VALID_CATEGORIES = [\"technology\", \"market\", \"health\", \"science\", \"business\", \"trending\", \"general\"];\nconst items = $input.all();\nconst byCategory = {};\nfor (const it of items) {\n  const cat = it.json.category;\n  if (!byCategory[cat]) byCategory[cat] = [];\n  byCategory[cat].push(it.json);\n}\nconst out = [];\nfor (const cat of VALID_CATEGORIES) {\n  const arts = byCategory[cat];\n  if (!arts || arts.length === 0) continue;\n  const bulletText = arts.map(a => `- ${a.title}: ${a.summary}`).join('\\n');\n  out.push({ json: {\n    category: cat,\n    article_count: arts.length,\n    bulletText: bulletText,\n    period_type: 'daily',\n    period_start: $now.toFormat('yyyy-MM-dd'),\n    period_end: $now.toFormat('yyyy-MM-dd')\n  } });\n}\nreturn out;\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        680,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "11",
      "name": "Group Weekly By Category",
      "parameters": {
        "jsCode": "\nconst VALID_CATEGORIES = [\"technology\", \"market\", \"health\", \"science\", \"business\", \"trending\", \"general\"];\nconst cutoff = $now.minus({ days: 7 });\nconst items = $input.all().filter(it => {\n  const d = new Date(it.json.period_start);\n  return d >= new Date(cutoff.toISODate());\n});\nconst byCategory = {};\nfor (const it of items) {\n  const cat = it.json.category;\n  if (!byCategory[cat]) byCategory[cat] = [];\n  byCategory[cat].push(it.json);\n}\nconst out = [];\nfor (const cat of VALID_CATEGORIES) {\n  const days = byCategory[cat];\n  if (!days || days.length === 0) continue;\n  const bulletText = days.map(d => `- ${d.period_start}: ${d.summary}`).join('\\n');\n  const totalArticles = days.reduce((s,d) => s + (Number(d.article_count) || 0), 0);\n  out.push({ json: {\n    category: cat, article_count: totalArticles, bulletText: bulletText,\n    period_type: 'weekly',\n    period_start: cutoff.toFormat('yyyy-MM-dd'),\n    period_end: $now.toFormat('yyyy-MM-dd')\n  } });\n}\nreturn out;\n",
        "mode": "runOnceForAllItems"
      },
      "position": [
        2600,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
