      "name": "Prepare Daily Rollup Rows",
      "parameters": {
        "jsCode": "\nconst enrichItems = $input.all();\nconst srcItems = $('Group Short-Term By Category').all();\nconst out = [];\nfor (let i = 0; i < enrichItems.length; i++) {\n  const raw = (enrichItems[i].json.response || '').trim();\n  const src = srcItems[i].json;\n  out.push({ json: {\n    period_type: src.period_type, period_start: src.period_start, period_end: src.period_end,\n    category: src.category, summary: raw || 'No summary generated', article_count: src.article_count,\n    top_entities: '', created_at: $now.toISO()\n  }});\n}\nreturn out;\n",
        "mode": "runOnceForAllItems"
