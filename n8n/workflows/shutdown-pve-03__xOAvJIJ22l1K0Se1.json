        "jsCode": "const results = {\n  'web-02': $('Re-check web-02 (241)').item.json.data?.status,\n  'DebDowner': $('Re-check DebDowner (109)').item.json.data?.status,\n  'Minecraft': $('Re-check Minecraft (110)').item.json.data?.status,\n};\nconst stillRunning = Object.entries(results).filter(([k, v]) => v !== 'stopped').map(([k, v]) => `${k}:${v}`);\nreturn [{ json: { allStopped: stillRunning.length === 0, results, stillRunning } }];"
