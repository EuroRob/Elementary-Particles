      "notes": "This task itself just flips NetBox fields — it finishes in seconds. The actual per-VM patch runs happen asynchronously afterward, triggered independently by patch_trigger.json, and are reported separately in System Alerts by that workflow.",
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
