        }
      },
      "id": "77936fdb-91bc-4d67-ae98-ec91e344a484",
      "name": "Reset patch_status=pending via IaC API",
      "notes": "Runs netbox_setup_patch_fields.yml --tags reset_pending.\nThis flips patch_status=pending on every patchable VM in NetBox.\nEach flip fires the NetBox Event Rule -> 'NetBox Patch Trigger' webhook -> rolling_update.yml per VM, one at a time (serial: 1), each snapshot-backed.\n\nCORRECTED 2026-08-17: dropped the dead Vault-fetch node (n8n env vars\nVAULT_TOKEN/NETBOX_VAULT_PATH were never actually set) in favor of the\nalready-configured 'IaC API (iac-api Bearer)' credential.\n\nKNOWN GAP as of 2026-08-17, not yet closed: only 7 of 12 patchable_vms hosts\nare currently registered in NetBox (dns-01, vpn-01, pg-01, web-01, web-02,\ngit-01, media-vm) — immich-01, jellyfin-01, dmz-nc-01, dmz-pg-01, and\nhome-assistant need `scripts/sync_netbox.py --all` (which needs config/vms/*.yaml\nmanifests that don't exist yet for them) before this monthly cycle will include\nthem. Until then, this cycle only covers the 7 registered hosts.",
      "parameters": {
        "authentication": "predefinedCredentialType",
        "jsonBody": "={{ JSON.stringify({ playbook: 'netbox_setup_patch_fields', inventory: 'production', tags: ['reset_pending'] }) }}",
        "method": "POST",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "allowUnauthorizedCerts": true
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://iac.internal:8000/api/tasks/ansible/netbox_setup_patch_fields"
      },
      "position": [
        500,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
