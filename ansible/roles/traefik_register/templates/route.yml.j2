{# =============================================================================
   Traefik file-provider dynamic route template
   Output: /etc/traefik/dynamic/{{ traefik_service_name }}.yml
   Hot-reloaded by Traefik file provider — no container restart needed.
   ============================================================================= #}
---
# Auto-generated by traefik_register Ansible role
# Service : {{ traefik_service_name }}
# Domain  : {{ traefik_domain }}
# Backend : {{ traefik_backend_url }}
# Auth    : {{ traefik_auth | default('none') }}
# Updated : {{ ansible_date_time.iso8601 | default(now(utc=True, fmt='%Y-%m-%dT%H:%M:%SZ')) }}

http:
  routers:
    {{ traefik_service_name }}:
      rule: "{{ _traefik_host_rule }}"
      entryPoints:
        - "{{ traefik_entrypoint | default('websecure') }}"
{% if traefik_tls | default(true) | bool %}
      tls:
{% if traefik_cert_resolver | default('') %}
        certResolver: "{{ traefik_cert_resolver }}"
{% if traefik_acme_domain | default('') %}
        # Request/reuse wildcard cert for *.{{ traefik_acme_domain }}
        domains:
          - main: "{{ traefik_acme_domain }}"
            sans:
              - "*.{{ traefik_acme_domain }}"
{% endif %}
{% endif %}
{% endif %}
{% if _traefik_middlewares | length > 0 %}
      middlewares:
{% for mw in _traefik_middlewares %}
        - "{{ mw }}"
{% endfor %}
{% endif %}
      service: "{{ traefik_service_name }}"
{% if traefik_permissions_policy_override | default('') %}

  middlewares:
    {{ traefik_service_name }}-headers:
      # Same posture as the shared secure-headers@file middleware, except
      # Permissions-Policy is overridden for this service specifically —
      # see traefik_register/tasks/main.yml for why this exists per-service
      # rather than loosening the shared default.
      headers:
        sslRedirect: true
        forceSTSHeader: true
        stsSeconds: 63072000
        stsIncludeSubdomains: true
        stsPreload: true
        frameDeny: true
        contentTypeNosniff: true
        browserXssFilter: true
        referrerPolicy: "strict-origin-when-cross-origin"
        permissionsPolicy: "{{ traefik_permissions_policy_override }}"
        customResponseHeaders:
          X-Robots-Tag: "none,noarchive,nosnippet,notranslate,noimageindex"
          Server: ""
{% endif %}

  services:
    {{ traefik_service_name }}:
      loadBalancer:
        servers:
          - url: "{{ traefik_backend_url }}"
{% if traefik_backend_insecure_tls | default(false) | bool %}
        serversTransport: "{{ traefik_service_name }}-insecure@file"
{% endif %}
        healthCheck:
          path: "{{ traefik_healthcheck_path | default('/') }}"
          interval: "30s"
          timeout: "5s"
{% if traefik_healthcheck_host | default('') %}
          hostname: "{{ traefik_healthcheck_host }}"
{% endif %}
{% if traefik_auth in ['one_factor', 'two_factor'] %}
        # Authelia forward-auth: {{ traefik_auth }} (enforced by authelia@file middleware above)
{% elif traefik_auth == 'oidc' %}
        # Auth: OIDC — service redirects to auth.home.example.org itself. No forward-auth
        # middleware here; adding authelia@file would cause a double-auth loop.
{% endif %}
{% if traefik_backend_insecure_tls | default(false) | bool %}

  serversTransports:
    {{ traefik_service_name }}-insecure:
      # Backend has its own self-signed cert (e.g. Proxmox's built-in web UI)
      # — Traefik still terminates the FRONT end with a real cert (see tls:
      # block above); this only affects the Traefik->backend leg.
      insecureSkipVerify: true
{% endif %}
