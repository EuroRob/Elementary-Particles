version: "3.8"
# Generated by Ansible authelia role — do not edit manually.
services:

  authelia:
    image: "{{ authelia_image }}"
    container_name: authelia
    restart: unless-stopped
    environment:
      AUTHELIA_JWT_SECRET_FILE:                   /secrets/jwt_secret
      AUTHELIA_SESSION_SECRET_FILE:               /secrets/session_secret
      AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE:       /secrets/storage_encryption_key
      AUTHELIA_STORAGE_POSTGRES_PASSWORD_FILE:    /secrets/pg_password
      AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET_FILE: /secrets/jwt_secret
{% if authelia_smtp_enabled %}
      AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE:       /secrets/smtp_password
{% endif %}
      TZ: "{{ timezone | default('UTC') }}"
    volumes:
      - "{{ authelia_config_dir }}:/config:ro"
      - "{{ authelia_secrets_dir }}:/secrets:ro"
    ports:
      - "127.0.0.1:{{ authelia_port }}:{{ authelia_port }}"
    # Hard caps so no single container can eat the host's RAM — see
    # incident_web01_memory_exhaustion_2026-08-25 memory note.
    mem_limit: 256m
    mem_reservation: 128m
    networks:
      - traefik
      - authelia_backend
    depends_on:
      authelia-redis:
        condition: service_healthy
    labels:
      traefik.enable: "true"
      traefik.http.routers.authelia.rule: "Host(`{{ authelia_fqdn }}`)"
      traefik.http.routers.authelia.entrypoints: "websecure"
      traefik.http.routers.authelia.tls: "true"
      traefik.http.services.authelia.loadbalancer.server.port: "{{ authelia_port }}"
      # Authelia itself must NOT have the authelia middleware (no auth loop)
      traefik.http.routers.authelia.middlewares: "secure-headers@file"
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:{{ authelia_port }}/api/health"]
      interval: 10s
      timeout: 5s
      retries: 5

  authelia-redis:
    image: "{{ authelia_redis_image }}"
    container_name: authelia-redis
    restart: unless-stopped
    mem_limit: 128m
    mem_reservation: 64m
    volumes:
      - authelia_redis_data:/data
    networks:
      - authelia_backend
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 3

volumes:
  authelia_redis_data:

networks:
  traefik:
    external: true
  authelia_backend:
    driver: bridge
