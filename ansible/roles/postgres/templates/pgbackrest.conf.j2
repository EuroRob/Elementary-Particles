# Managed by Ansible (Roles/postgres/tasks/pgbackrest.yml) -- do not edit by hand.
# Repo: {{ postgres_pgbackrest_nfs_source }} mounted at {{ postgres_pgbackrest_repo_path }}.
# Unencrypted on purpose (like the vzdumps on the same NAS): the key would live
# in Vault, and a backup you can't decrypt after losing Vault is no backup.
[global]
repo1-path={{ postgres_pgbackrest_repo_path }}
repo1-retention-full={{ postgres_pgbackrest_retention_full }}
repo1-retention-full-type=count
repo1-bundle=y
repo1-block=y
compress-type=zst
compress-level=3
process-max={{ postgres_pgbackrest_process_max }}
# No forced checkpoint at backup start -> no I/O spike (backup waits for the next one).
start-fast=n
delta=y
# Async archiving: commits never wait on the network. If the repo is unreachable,
# WAL queues in the local spool up to archive-push-queue-max, after which the
# oldest is DROPPED (a PITR gap) instead of filling the disk like 2026-09-02.
archive-async=y
spool-path=/var/spool/pgbackrest
archive-push-queue-max={{ postgres_pgbackrest_queue_max }}
log-path=/var/log/pgbackrest
log-level-console=info
log-level-file=detail

[global:archive-push]
process-max={{ postgres_pgbackrest_process_max }}

[{{ postgres_pgbackrest_stanza }}]
pg1-path={{ postgres_data_dir }}
