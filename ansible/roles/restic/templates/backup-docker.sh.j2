#!/usr/bin/env bash
# =============================================================================
# {{ restic_scripts_dir }}/backup-{{ item.name }}.sh
# Type  : docker — pause compose stacks, backup paths, unpause
# Job   : {{ item.name }}
# Host  : {{ inventory_hostname }}
# Generated by Ansible restic role — do not hand-edit.
#
# Strategy:
#   docker compose pause  — freezes container I/O (writes stop) — typically <1s
#   restic backup         — reads consistent on-disk state
#   docker compose unpause — resumes
#   Total downtime: only during the restic backup pass (~seconds for configs,
#                   ~minutes for large data). Containers remain up but frozen.
# =============================================================================
set -euo pipefail

JOB="{{ item.name }}"
LOGFILE="{{ restic_log_dir }}/${JOB}.log"
ALERT_SCRIPT="{{ restic_scripts_dir }}/alert.sh"

log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [${JOB}] $*" | tee -a "${LOGFILE}"; }
fail() {
  log "ERROR: $*"
  # Always try to unpause on failure so containers don't stay frozen
  _unpause_all
  "${ALERT_SCRIPT}" "${JOB}" "$*"
  exit 1
}

COMPOSE_DIRS=(
{% for d in item.compose_dirs | default([]) %}
  "{{ d }}"
{% endfor %}
)

_pause_all() {
  for dir in "${COMPOSE_DIRS[@]}"; do
    if [[ -f "${dir}/docker-compose.yml" ]]; then
      log "Pausing ${dir}..."
      docker compose -f "${dir}/docker-compose.yml" pause 2>&1 | tee -a "${LOGFILE}" || true
    fi
  done
}

_unpause_all() {
  for dir in "${COMPOSE_DIRS[@]}"; do
    if [[ -f "${dir}/docker-compose.yml" ]]; then
      log "Unpausing ${dir}..."
      docker compose -f "${dir}/docker-compose.yml" unpause 2>&1 | tee -a "${LOGFILE}" || true
    fi
  done
}

log "=== Backup job '${JOB}' started ==="

# Load credentials
# shellcheck source=/dev/null
set -a; source {{ restic_config_dir }}/primary.env; set +a

BACKUP_PATHS=(
{% for path in item.paths | default([]) %}
  "{{ path }}"
{% endfor %}
)

EXCLUDE_ARGS=(
{% for pattern in item.excludes | default([]) %}
  --exclude "{{ pattern }}"
{% endfor %}
)

# Pause compose stacks for consistency
_pause_all

# Run backup (trap to ensure unpause on any exit)
trap _unpause_all EXIT

log "Running restic backup..."
restic backup \
  "${BACKUP_PATHS[@]}" \
  "${EXCLUDE_ARGS[@]}" \
  --tag "job:${JOB}" \
  --tag "host:{{ inventory_hostname }}" \
  --verbose=1 \
  2>&1 | tee -a "${LOGFILE}" || fail "restic backup failed"

# Unpause (also done by EXIT trap, but explicit is clearer)
trap - EXIT
_unpause_all

log "=== Backup job '${JOB}' completed successfully ==="
