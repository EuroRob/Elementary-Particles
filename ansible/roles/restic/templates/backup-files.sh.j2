#!/usr/bin/env bash
# =============================================================================
# {{ restic_scripts_dir }}/backup-{{ item.name }}.sh
# Type  : files — back up static paths directly (no service interruption)
# Job   : {{ item.name }}
# Host  : {{ inventory_hostname }}
# Generated by Ansible restic role — do not hand-edit.
# =============================================================================
set -euo pipefail

JOB="{{ item.name }}"
LOGFILE="{{ restic_log_dir }}/${JOB}.log"
ALERT_SCRIPT="{{ restic_scripts_dir }}/alert.sh"

log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [${JOB}] $*" | tee -a "${LOGFILE}"; }
fail() { log "ERROR: $*"; "${ALERT_SCRIPT}" "${JOB}" "$*"; exit 1; }

log "=== Backup job '${JOB}' started ==="

# Load credentials (RESTIC_REPOSITORY, RESTIC_PASSWORD, AWS_*)
# shellcheck source=/dev/null
set -a; source {{ restic_config_dir }}/primary.env; set +a

BACKUP_PATHS=(
{% for path in item.paths | default([]) %}
  "{{ path }}"
{% endfor %}
)

EXCLUDE_ARGS=(
{% for pattern in item.excludes | default([]) %}
  --exclude "{{ pattern }}"
{% endfor %}
)

# Verify all paths exist before starting
for p in "${BACKUP_PATHS[@]}"; do
  if [[ ! -e "$p" ]]; then
    log "WARN: path '${p}' does not exist — skipping"
    BACKUP_PATHS=("${BACKUP_PATHS[@]/$p}")
  fi
done

log "Paths: ${BACKUP_PATHS[*]}"

restic backup \
  "${BACKUP_PATHS[@]}" \
  "${EXCLUDE_ARGS[@]}" \
  --tag "job:${JOB}" \
  --tag "host:{{ inventory_hostname }}" \
  --verbose=1 \
  2>&1 | tee -a "${LOGFILE}" || fail "restic backup failed"

log "=== Backup job '${JOB}' completed successfully ==="
