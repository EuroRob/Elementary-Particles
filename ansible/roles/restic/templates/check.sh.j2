#!/usr/bin/env bash
# check.sh — spot integrity check (reads random 5% of pack data)
set -euo pipefail
LOGFILE="{{ restic_log_dir }}/check.log"
log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [check] $*" | tee -a "${LOGFILE}"; }
set -a; source {{ restic_config_dir }}/primary.env; set +a

log "=== Repository check started ==="
restic check --read-data-subset=5% --verbose=1 2>&1 | tee -a "${LOGFILE}"
RC=${PIPESTATUS[0]}
if [[ ${RC} -ne 0 ]]; then
  {{ restic_scripts_dir }}/alert.sh "check" "Repository integrity check FAILED on {{ inventory_hostname }}"
  exit ${RC}
fi
log "=== Repository check passed ==="
