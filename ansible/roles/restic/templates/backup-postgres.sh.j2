#!/usr/bin/env bash
# =============================================================================
# {{ restic_scripts_dir }}/backup-{{ item.name }}.sh
# Type  : postgres — pg_dump each database and pipe directly into restic
# Job   : {{ item.name }}
# Host  : {{ inventory_hostname }}
# Generated by Ansible restic role — do not hand-edit.
#
# Strategy:
#   - pg_dump --format=custom (compressed binary) piped to restic via stdin
#   - No temporary dump file on disk — eliminates disk space spike + risk
#   - Each database is a separate restic snapshot with tag db:<name>
#   - Uses PGPASSWORD env var — never touches ~/.pgpass
# =============================================================================
set -euo pipefail

JOB="{{ item.name }}"
PG_HOST="{{ item.pg_host | default('localhost') }}"
PG_PORT="{{ item.pg_port | default('5432') }}"
PG_USER="{{ item.pg_user | default('postgres') }}"
LOGFILE="{{ restic_log_dir }}/${JOB}.log"
ALERT_SCRIPT="{{ restic_scripts_dir }}/alert.sh"

log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [${JOB}] $*" | tee -a "${LOGFILE}"; }
fail() { log "ERROR: $*"; "${ALERT_SCRIPT}" "${JOB}" "$*"; exit 1; }

log "=== Backup job '${JOB}' started ==="

# Load restic credentials
# shellcheck source=/dev/null
set -a; source {{ restic_config_dir }}/primary.env; set +a

# Load PG password (PGPASSWORD comes from the env file too)
# Vault writes PGPASSWORD=... into primary.env during deploy_backup.yml

# Discover databases
{% if item.databases == 'all' %}
log "Discovering all databases..."
DATABASES=$(
  PGPASSWORD="${PGPASSWORD}" psql \
    -h "${PG_HOST}" -p "${PG_PORT}" -U "${PG_USER}" \
    -At -c "SELECT datname FROM pg_database
             WHERE datistemplate = false
               AND datname != 'postgres'
             ORDER BY datname;"
) || fail "Could not list databases"
{% else %}
DATABASES="{{ item.databases | join(' ') }}"
{% endif %}

log "Databases to back up: ${DATABASES}"

FAILED=0
for DB in ${DATABASES}; do
  log "Dumping: ${DB}..."
  PGPASSWORD="${PGPASSWORD}" pg_dump \
    -h "${PG_HOST}" -p "${PG_PORT}" -U "${PG_USER}" \
    --format=custom \
    --no-password \
    "${DB}" \
    | restic backup \
        --stdin \
        --stdin-filename "${DB}.dump" \
        --tag "job:${JOB}" \
        --tag "host:{{ inventory_hostname }}" \
        --tag "db:${DB}" \
        2>&1 | tee -a "${LOGFILE}"

  if [[ ${PIPESTATUS[0]} -ne 0 || ${PIPESTATUS[1]} -ne 0 ]]; then
    log "ERROR: dump of '${DB}' failed"
    FAILED=$((FAILED + 1))
  else
    log "OK: ${DB}"
  fi
done

if [[ ${FAILED} -gt 0 ]]; then
  fail "${FAILED} database dump(s) failed"
fi

log "=== Backup job '${JOB}' completed successfully ==="
