{# =============================================================================
   Traefik dynamic config: Authelia forwardauth middleware
   Dest: /etc/traefik/dynamic/authelia.yml
   This file MUST be present so that authelia@file middleware resolves.
   Referenced by: traefik_register role (traefik_auth: one_factor/two_factor)
                  acme-wildcard.yml.j2 (Traefik dashboard protection)
   ============================================================================= #}
---
# Auto-generated by Ansible traefik role — do not hand-edit.
# Authelia SSO endpoint: {{ authelia_url | default('https://auth.' + (base_domain | default('homelab.local'))) }}

http:
  middlewares:
    # ── Single-factor authentication ─────────────────────────────────────────
    authelia:
      forwardAuth:
        address: "http://authelia:{{ authelia_port | default('9091') }}/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Name
          - Remote-Email

    # ── Two-factor authentication ─────────────────────────────────────────────
    authelia-2fa:
      forwardAuth:
        address: "http://authelia:{{ authelia_port | default('9091') }}/api/authz/forward-auth?authelia_url={{ authelia_url | default('https://auth.' + (base_domain | default('homelab.local'))) }}"
        trustForwardHeader: true
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Name
          - Remote-Email
