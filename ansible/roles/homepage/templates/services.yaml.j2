- Automation:
    - n8n:
        icon: n8n.png
        href: "{{ homepage_services.n8n_url }}"
        description: "Workflow orchestration"
        ping: "{{ ansible_host | default('10.0.30.20') }}"
    - IaC API:
        icon: mdi-api
        href: "{{ homepage_services.iac_api_url }}"
        description: "Terraform & Ansible orchestration API"
