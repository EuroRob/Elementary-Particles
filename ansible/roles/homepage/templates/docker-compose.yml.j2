version: "3.8"
# Generated by Ansible homepage role — do not edit manually.
services:
  homepage:
    image: "{{ homepage_image }}"
    container_name: homepage
    restart: unless-stopped
    # Hard cap so no single container can eat the host's RAM — see
    # incident_web01_memory_exhaustion_2026-08-25 memory note.
    mem_limit: 256m
    mem_reservation: 128m
    ports:
      - "{{ homepage_port }}:3000"
    volumes:
      - "{{ homepage_config_dir }}:/app/config"
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: "{{ timezone | default('UTC') }}"
    labels:
      traefik.enable: "true"
      traefik.http.routers.homepage.rule: "Host(`{{ homepage_fqdn }}`)"
      traefik.http.routers.homepage.entrypoints: "websecure"
      traefik.http.routers.homepage.tls: "true"
      traefik.http.services.homepage.loadbalancer.server.port: "3000"
    networks:
      - traefik

networks:
  traefik:
    external: true
