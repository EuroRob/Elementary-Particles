# Generated by scripts/vault_lanes.py from vault/lanes.yml -- edit lanes.yml, then render.
# Claude Code's token. Reads the infra lane only; may create (never read) a new
# secret anywhere, so seeding a new service still works.

path "secret/metadata/*" {
  capabilities = ["list"]
}

path "secret/data/*" {
  capabilities = ["create"]
}

