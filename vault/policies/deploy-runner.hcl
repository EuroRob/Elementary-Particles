# Generated by scripts/vault_lanes.py from vault/lanes.yml -- edit lanes.yml, then render.
# The deploy runner (AppRole deploy-runner): reads every secret, as Ansible and
# Terraform need. Its secret_id is readable only by the runner's Unix user; a run
# needs the owner's sudo password. No delete, no policy or auth changes.

path "secret/data/*" {
  capabilities = ["create", "read", "update"]
}

path "secret/metadata/*" {
  capabilities = ["list", "read"]
}
