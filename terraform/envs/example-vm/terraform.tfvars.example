# =============================================================================
# terraform.tfvars.example — web-02 (Jira + Confluence)
# Copy to terraform.tfvars and fill in secrets. DO NOT commit terraform.tfvars.
# =============================================================================

vault_addr = "http://vault.internal:8200"
# role_id   = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# secret_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Proxmox — pve-01 (pve-01, primary, always-on; will move to 10.10.10.11 after MGMT VLAN migration)
proxmox_node       = "pve-01"
proxmox_url        = "https://10.10.0.11:8006"
vm_id              = 241
ubuntu_template_id = 9002

# VM resources
# Jira JVM max 2GB + Confluence JVM max 2GB + ~2GB OS/container overhead = 6GB total
vm_cores     = 4
vm_memory_mb = 6144
vm_disk_gb   = 64
vm_datastore = "zfs-nvme"

# Network — VLAN30 Services
vm_vlan_tag  = 30
vm_static_ip = "10.10.30.11"
vm_gateway   = "10.10.30.1"
vm_dns       = "10.10.30.10"
